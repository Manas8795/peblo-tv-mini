# ==============================================================================
# Peblo TV Mini — Environment Configuration
# ==============================================================================

# Database Connection
# Local Docker Compose uses PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@db:5432/peblo_tv
# Local zero-dependency dev fallback:
# DATABASE_URL=sqlite:///./peblo_tv.db

# Database Credentials (used by docker-compose for postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=peblo_tv

# Application Authentication Keys / Roles
# Used by header 'X-API-Key' or 'Authorization: Bearer <key>'
ADMIN_API_KEY=admin-secret-key-peblo
EDITOR_API_KEY=editor-secret-key-peblo

# Storage Backend Provider: "local" (default) or "r2" (Cloudflare R2 / AWS S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage

# Cloudflare R2 / AWS S3 Credentials (Required only when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=peblo-tv-mini
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Server Environment
ENV=development
DEBUG=true

# ==============================================================================
# Production Secrets Management Strategy (Part D.3):
# In production, secrets (database credentials, Cloudflare R2 tokens, and admin API
# keys) should NEVER be committed to Git or hardcoded in container images.
# Instead, they should be managed via a centralized secrets vault such as AWS Secrets
# Manager, HashiCorp Vault, or Doppler, and injected dynamically at container runtime:
# 1. CI/CD (GitHub Actions) references encrypted repository secrets (e.g. ${{ secrets.PROD_DB_URL }})
#    and pushes built Docker images without embedded secrets.
# 2. Container orchestrators (Kubernetes / ECS / Cloud Run) retrieve credentials from
#    the secrets manager during container bootstrap via native IAM role integration or
#    sealed secrets, injecting them into process environment variables.
# 3. Access keys should be regularly rotated using automated secret rotation lambdas.
# ==============================================================================
